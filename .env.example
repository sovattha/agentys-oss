# ============================================================================
# Agentys - Configuration Complète
# ============================================================================
# Ce fichier contient TOUTES les variables d'environnement disponibles.
# Copiez ce fichier vers ".env" et configurez les valeurs nécessaires.
#
# LÉGENDE:
#   [OBLIGATOIRE] - Variable requise pour le fonctionnement de base
#   [OPTIONNEL]   - Variable avec valeur par défaut, personnalisable
#   [AVANCÉ]      - Pour utilisateurs expérimentés
#
# CONSEIL: Commencez par configurer IMAP/SMTP pour un démarrage rapide
# ============================================================================


# ============================================================================
# PROVIDER EMAIL (choisir UN provider)
# ============================================================================
# Options: IMAP_SMTP (recommandé), GMAIL, OUTLOOK, IMAP, SMTP
# IMAP_SMTP utilise IMAP pour la lecture et SMTP pour l'envoi (le plus simple)

# [OBLIGATOIRE] Type de provider email
EMAIL_PROVIDER_TYPE=IMAP_SMTP


# ============================================================================
# IMAP - Serveurs génériques (lecture d'emails)
# ============================================================================
# Configuration nécessaire pour EMAIL_PROVIDER_TYPE=IMAP ou IMAP_SMTP
# Exemples: Gmail (imap.gmail.com), Outlook (outlook.office365.com)

# [OBLIGATOIRE si IMAP] Serveur IMAP
IMAP_HOST=imap.example.com

# [OPTIONNEL] Port IMAP (993 pour SSL, 143 sans SSL)
IMAP_PORT=993

# [OBLIGATOIRE si IMAP] Nom d'utilisateur (généralement l'adresse email)
IMAP_USER=user@example.com

# [OBLIGATOIRE si IMAP] Mot de passe ou mot de passe d'application
IMAP_PASSWORD=your-password

# [OPTIONNEL] Utiliser SSL (défaut: true)
IMAP_USE_SSL=true

# [OPTIONNEL] Dossier à surveiller (défaut: INBOX)
IMAP_FOLDER=INBOX


# ============================================================================
# SMTP - Serveurs génériques (envoi d'emails)
# ============================================================================
# Configuration nécessaire pour EMAIL_PROVIDER_TYPE=SMTP ou IMAP_SMTP
# Exemples: Gmail (smtp.gmail.com), Outlook (smtp.office365.com)

# [OBLIGATOIRE si SMTP] Serveur SMTP
SMTP_HOST=smtp.example.com

# [OPTIONNEL] Port SMTP (587 pour TLS, 465 pour SSL, 25 sans chiffrement)
SMTP_PORT=587

# [OBLIGATOIRE si SMTP] Nom d'utilisateur
SMTP_USER=user@example.com

# [OBLIGATOIRE si SMTP] Mot de passe ou mot de passe d'application
SMTP_PASSWORD=your-password

# [OPTIONNEL] Utiliser STARTTLS (défaut: true, recommandé pour port 587)
SMTP_USE_TLS=true

# [OPTIONNEL] Utiliser SSL direct (défaut: false, pour port 465)
SMTP_USE_SSL=false

# [OPTIONNEL] Adresse email d'expédition (défaut: SMTP_USER)
SMTP_FROM_EMAIL=user@example.com

# [OPTIONNEL] Nom d'affichage de l'expéditeur
SMTP_FROM_NAME=Mon Nom


# ============================================================================
# OUTLOOK - Microsoft Graph API
# ============================================================================
# Configuration nécessaire pour EMAIL_PROVIDER_TYPE=OUTLOOK
# Créez une application dans Azure Portal: https://portal.azure.com

# [OBLIGATOIRE si OUTLOOK] ID du tenant Azure
AZURE_TENANT_ID=your-tenant-id

# [OBLIGATOIRE si OUTLOOK] ID de l'application Azure
AZURE_CLIENT_ID=your-client-id

# [OBLIGATOIRE si OUTLOOK] Secret de l'application Azure
AZURE_CLIENT_SECRET=your-client-secret

# [OBLIGATOIRE si OUTLOOK] Email de l'utilisateur Outlook
OUTLOOK_USER_ID=user@example.com


# ============================================================================
# GMAIL - Google API
# ============================================================================
# Configuration nécessaire pour EMAIL_PROVIDER_TYPE=GMAIL
# Créez un projet dans Google Cloud Console: https://console.cloud.google.com

# Option 1: Fichier credentials.json (OAuth interactif)
# [OPTIONNEL] Chemin vers le fichier credentials OAuth
GOOGLE_CREDENTIALS_FILE=credentials.json

# [OPTIONNEL] Chemin vers le fichier token (auto-généré)
GOOGLE_TOKEN_FILE=token.json

# Option 2: Refresh token pré-généré (recommandé pour serveurs)
# [OBLIGATOIRE si GMAIL sans fichier] ID client OAuth
GOOGLE_CLIENT_ID=your-client-id

# [OBLIGATOIRE si GMAIL sans fichier] Secret client OAuth
GOOGLE_CLIENT_SECRET=your-client-secret

# [OBLIGATOIRE si GMAIL sans fichier] Refresh token pré-généré
GOOGLE_REFRESH_TOKEN=your-refresh-token


# ============================================================================
# LLM - Configuration du modèle IA
# ============================================================================

# [OBLIGATOIRE] Provider LLM: "claude" ou "ollama"
LLM_PROVIDER=claude

# [OPTIONNEL] Modèle par défaut
# Claude: claude-sonnet-4-6, claude-opus-4-7
# Ollama: mixtral:latest, llama2:latest, etc.
LLM_MODEL=claude-sonnet-4-6

# [OPTIONNEL] Modèle rapide pour tâches légères (classification, priorité)
LLM_MODEL_FAST=claude-sonnet-4-6

# [OPTIONNEL] Modèle intelligent pour tâches complexes (rédaction)
LLM_MODEL_SMART=claude-opus-4-7

# [OBLIGATOIRE si LLM_PROVIDER=claude] Clé API Anthropic
# Obtenez-la sur: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# [OPTIONNEL] Clé API OpenAI (pour TTS + fallback STT whisper-1)
# Obtenez-la sur: https://platform.openai.com/
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# [OPTIONNEL] Clé API Deepgram (STT primaire: nova-3, rapide, précis sur le français)
# Obtenez-la sur: https://console.deepgram.com/
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxx
# [OPTIONNEL] Override le modèle Deepgram (défaut: nova-3)
# DEEPGRAM_MODEL=nova-3

# ============================================================================
# STRIPE BILLING - Abonnements (plans) + facturation usage LLM
# ============================================================================

# [OBLIGATOIRE pour le checkout] Price IDs Stripe par plan ET par période.
# Le backend résout STRIPE_PRICE_<PLAN>_<PERIODE> (app/api/billing.py).
# IMPORTANT : il faut les QUATRE. Si une variable _YEARLY manque, SEUL le
# paiement annuel échoue ("Impossible d'ouvrir le paiement Stripe") tandis que
# le mensuel continue de marcher — bug typique d'un déploiement qui n'a configuré
# que les prix mensuels.
STRIPE_PRICE_STARTER_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
# [COMPAT] Alias hérités de l'implémentation Pro-only : STRIPE_PRICE_PRO_MONTHLY
# / STRIPE_PRICE_PRO_YEARLY sont acceptés en repli UNIQUEMENT pour "professional".
# Le plan "starter" n'a PAS d'alias : il exige ses propres variables ci-dessus.

# [OPTIONNEL] Price metered Stripe ajouté aux abonnements pour les dépassements LLM
STRIPE_LLM_OVERAGE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# [OPTIONNEL] Nom de l'event Stripe Meter pour les dépassements LLM
STRIPE_LLM_OVERAGE_METER_EVENT_NAME=agentys_llm_overage

# [OBLIGATOIRE si LLM_PROVIDER=ollama] URL du serveur Ollama
OLLAMA_BASE_URL=http://localhost:11434


# ============================================================================
# DAEMON - Configuration du service automatique
# ============================================================================

# [OPTIONNEL] Intervalle de polling en secondes (défaut: 60)
DAEMON_POLL_INTERVAL=60

# [OPTIONNEL] Ignorer les emails de faible priorité: newsletters, promos, spam (défaut: true)
DAEMON_SKIP_LOW_PRIORITY=true

# [OPTIONNEL] Intervalle d'apprentissage en nombre d'emails (défaut: 50)
DAEMON_LEARNING_INTERVAL=50

# [OPTIONNEL] Intervalle de vérification des follow-ups en minutes (défaut: 10)
DAEMON_FOLLOWUP_CHECK_INTERVAL=10

# [OPTIONNEL] Nombre max d'emails à traiter par cycle (défaut: 50)
EMAIL_MAX_PER_POLL=50

# [AVANCÉ] Tokens max pour le contenu email (défaut: 8000)
MAX_EMAIL_TOKENS=8000

# [AVANCÉ] Caractères moyens par token (défaut: 4.0)
CHARS_PER_TOKEN=4.0


# ============================================================================
# LOGGING - Configuration des logs
# ============================================================================

# [OPTIONNEL] Niveau de log: DEBUG, INFO, WARNING, ERROR (défaut: INFO)
LOG_LEVEL=INFO

# [OPTIONNEL] Format des logs: "standard" ou "json" (défaut: standard)
LOG_FORMAT=standard

# [OPTIONNEL] Taille max d'un fichier log en bytes (défaut: 10MB)
LOG_MAX_BYTES=10485760

# [OPTIONNEL] Nombre de fichiers log de backup (défaut: 5)
LOG_BACKUP_COUNT=5

# [OPTIONNEL] Écrire les logs dans un fichier (défaut: true)
LOG_TO_FILE=true

# [OPTIONNEL] Écrire les logs dans la console (défaut: true)
LOG_TO_CONSOLE=true


# ============================================================================
# FOLLOW-UPS - Relances automatiques
# ============================================================================

# [OPTIONNEL] Délai avant première relance en jours (défaut: 3)
FOLLOWUP_DELAY_DAYS=3

# [OPTIONNEL] Nombre maximum de relances par email (défaut: 3)
MAX_FOLLOWUPS=3


# ============================================================================
# LEARNING - Apprentissage automatique
# ============================================================================

# [OPTIONNEL] Seuil de confiance minimum pour action automatique (0-100, défaut: 70)
CONFIDENCE_THRESHOLD=70


# ============================================================================
# NOTIFICATIONS - Alertes bureau et push
# ============================================================================

# [OPTIONNEL] Activer les notifications bureau (défaut: true)
NOTIFICATIONS_ENABLED=true

# [OPTIONNEL] Activer le son des notifications (défaut: true)
NOTIFICATIONS_SOUND=true

# [OPTIONNEL] Durée d'affichage en secondes (défaut: 5)
NOTIFICATIONS_TIMEOUT=5

# [OPTIONNEL] Activer les notifications push mobiles (défaut: true)
PUSH_NOTIFICATIONS_ENABLED=true


# ============================================================================
# MESSAGING - Canaux multi-plateformes (Discord, Telegram, Slack)
# ============================================================================
# Ces providers permettent de recevoir et répondre aux messages depuis
# différentes plateformes via l'Unified Inbox d'Agentys.

# [OPTIONNEL] Type de provider message actif
MESSAGE_PROVIDER_TYPE=DISCORD


# ============================================================================
# DISCORD - Bot Discord
# ============================================================================
# Créez un bot sur: https://discord.com/developers/applications
# Permissions requises: Send Messages, Read Message History, Read Messages/View Channels

# [OBLIGATOIRE si DISCORD] Token du bot Discord
DISCORD_BOT_TOKEN=your-bot-token-here


# ============================================================================
# TELEGRAM - Bot Telegram (en développement)
# ============================================================================
# Créez un bot avec @BotFather: https://t.me/BotFather

# [OBLIGATOIRE si TELEGRAM] Token du bot Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token


# ============================================================================
# SLACK - App Slack (en développement)
# ============================================================================
# Créez une app sur: https://api.slack.com/apps

# [OBLIGATOIRE si SLACK] Token du bot Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token

# [OBLIGATOIRE si SLACK] Token d'app pour Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token

# [OPTIONNEL] URL du webhook Slack (pour notifications simples)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# [OPTIONNEL] Canal de destination
SLACK_CHANNEL=#agentys-notifications

# [OPTIONNEL] Nom d'utilisateur du bot (défaut: Agentys)
SLACK_USERNAME=Agentys

# [OPTIONNEL] Emoji du bot (défaut: :robot_face:)
SLACK_ICON_EMOJI=:robot_face:


# ============================================================================
# MICROSOFT TEAMS - Intégration Teams
# ============================================================================

# [OPTIONNEL] URL du webhook Teams
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxx


# ============================================================================
# FIREBASE - Push notifications FCM
# ============================================================================

# [OPTIONNEL] Chemin vers le fichier credentials Firebase
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# [OPTIONNEL] ID du projet Firebase
FIREBASE_PROJECT_ID=your-project-id

# [OPTIONNEL] Clé privée Firebase (alternative au fichier)
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# [OPTIONNEL] Email du compte de service Firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com


# ============================================================================
# EXPO - Push notifications Expo (React Native)
# ============================================================================

# [OPTIONNEL] Token d'accès Expo
EXPO_ACCESS_TOKEN=ExponentPushToken[xxxxxxxxxxxx]


# ============================================================================
# VOICE - Synthèse et reconnaissance vocale
# ============================================================================

# [OPTIONNEL] Activer la synthèse vocale (défaut: true)
TTS_ENABLED=true

# [OPTIONNEL] Vitesse de parole en mots/minute (défaut: 175)
TTS_RATE=175

# [OPTIONNEL] Volume de 0.0 à 1.0 (défaut: 1.0)
TTS_VOLUME=1.0

# [OPTIONNEL] Activer l'interface web voice (défaut: true)
VOICE_WEB_ENABLED=true

# [OPTIONNEL] Port de l'interface web voice (défaut: 5001)
VOICE_WEB_PORT=5001

# [OPTIONNEL] Taille max des fichiers audio en MB (défaut: 10)
VOICE_MAX_AUDIO_MB=10


# ============================================================================
# DASHBOARD - Interface web de monitoring
# ============================================================================

# [OPTIONNEL] Clé secrète Flask (auto-générée si absente)
FLASK_SECRET_KEY=your-secret-key-here

# [OPTIONNEL] Origines CORS autorisées (séparées par virgules)
DASHBOARD_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000


# ============================================================================
# API - Serveur API REST
# ============================================================================

# [OPTIONNEL] Port du serveur API (défaut: 5000)
API_PORT=5000

# [OPTIONNEL] Hôte du serveur API (défaut: 127.0.0.1)
API_HOST=127.0.0.1

# [OPTIONNEL] Origines CORS autorisées pour l'API (séparées par virgules)
API_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000


# ============================================================================
# METRICS - Métriques Prometheus
# ============================================================================

# [OPTIONNEL] Activer les métriques (défaut: true)
METRICS_ENABLED=true

# [OPTIONNEL] Port du serveur de métriques (défaut: 9090)
METRICS_PORT=9090

# [OPTIONNEL] Nom de l'environnement (défaut: development)
ENVIRONMENT=development


# ============================================================================
# FONCTIONNALITÉS AVANCÉES
# ============================================================================

# [OPTIONNEL] Activer le multi-comptes (défaut: true)
MULTI_ACCOUNTS_ENABLED=true

# [OPTIONNEL] Activer le routage par règles (défaut: true)
ROUTING_RULES_ENABLED=true

# [OPTIONNEL] Activer les templates d'emails (défaut: true)
EMAIL_TEMPLATES_ENABLED=true

# [OPTIONNEL] Activer la revue des brouillons (défaut: false)
DRAFT_REVIEW_ENABLED=false


# ============================================================================
# A/B TESTING - Tests comparatifs
# ============================================================================

# [OPTIONNEL] Activer les tests A/B (défaut: true)
AB_TESTING_ENABLED=true

# [OPTIONNEL] Échantillons minimum pour significativité (défaut: 30)
AB_MIN_SAMPLES=30

# [OPTIONNEL] Niveau de confiance statistique (défaut: 0.95)
AB_CONFIDENCE_LEVEL=0.95


# ============================================================================
# SÉCURITÉ ET CHIFFREMENT
# ============================================================================

# [AVANCÉ] Clé de chiffrement pour données sensibles
# En production, OBLIGATOIRE - générez avec: python -c "import secrets; print(secrets.token_hex(32))"
AGENTYS_ENCRYPTION_KEY=

# [AVANCÉ] Environnement: development, staging, production
# En production, certaines fonctionnalités de sécurité sont activées
AGENTYS_ENV=development


# ============================================================================
# BUDGET ET RÉTENTION
# ============================================================================

# [OPTIONNEL] Budget mensuel max en USD (0 = illimité)
MONTHLY_BUDGET_USD=0

# [OPTIONNEL] Durée de rétention des données en jours (défaut: 90)
DATA_RETENTION_DAYS=90


# ============================================================================
# RETRY - Configuration des tentatives de reconnexion
# ============================================================================

# [AVANCÉ] Nombre max de tentatives en cas d'échec (défaut: 3)
RETRY_MAX_ATTEMPTS=3

# [AVANCÉ] Facteur de backoff exponentiel (défaut: 2.0)
RETRY_BACKOFF_FACTOR=2.0

# [AVANCÉ] Délai initial entre tentatives en secondes (défaut: 1.0)
RETRY_INITIAL_DELAY=1.0

# [AVANCÉ] Délai maximum entre tentatives en secondes (défaut: 60.0)
RETRY_MAX_DELAY=60.0


# ============================================================================
# CIRCUIT BREAKER - Protection contre les pannes en cascade
# ============================================================================

# [AVANCÉ] Nombre d'échecs avant ouverture du circuit (défaut: 5)
CB_FAILURE_THRESHOLD=5

# [AVANCÉ] Temps de récupération en secondes (défaut: 60)
CB_RECOVERY_TIMEOUT=60

# [AVANCÉ] Appels max en état half-open (défaut: 3)
CB_HALF_OPEN_MAX_CALLS=3


# ============================================================================
# RATE LIMITING - Limites d'API
# ============================================================================

# [AVANCÉ] Requêtes Claude par minute (défaut: 50)
CLAUDE_RPM=50

# [AVANCÉ] Tokens Claude par minute (défaut: 100000)
CLAUDE_TPM=100000

# [AVANCÉ] Requêtes Gmail par seconde (défaut: 10)
GMAIL_RPS=10

# [AVANCÉ] Requêtes Gmail par jour (défaut: 1000000)
GMAIL_RPD=1000000

# [AVANCÉ] Requêtes Outlook par minute (défaut: 60)
OUTLOOK_RPM=60


# ============================================================================
# MONITORING / SENTRY
# ============================================================================

# [OPTIONNEL] Sentry DSN pour le suivi d'erreurs (laisser vide pour désactiver)
SENTRY_DSN=

# [OPTIONNEL] Token Sentry pour le source maps upload (CI uniquement)
SENTRY_AUTH_TOKEN=


# ============================================================================
# OAUTH — REDIRECTS
# ============================================================================

# [OPTIONNEL] URI de redirection Google OAuth (défaut: http://localhost:5050/oauth/callback/google)
GOOGLE_REDIRECT_URI=http://localhost:5050/oauth/callback/google
