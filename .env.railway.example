# =============================================================================
# Agentys — Variables d'environnement pour Railway
# =============================================================================
# Copier ces variables dans le dashboard Railway > Variables

# --- Railway (auto) ---
# PORT est défini automatiquement par Railway — ne pas le définir manuellement

# --- API Server ---
API_HOST=0.0.0.0
ENVIRONMENT=production
FLASK_ENV=production

# --- CORS ---
# Origines autorisées (séparées par des virgules)
# Inclure le domaine Railway, tauri://localhost, et localhost pour le dev
API_CORS_ORIGINS=https://<app>.up.railway.app,tauri://localhost,http://localhost:1420

# --- LLM ---
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...

# --- Speech-to-Text (dictée vocale dans le composer) ---
# Primaire: Deepgram nova-3 (rapide, précis sur le français)
# Fallback: OpenAI whisper-1 si Deepgram indisponible
DEEPGRAM_API_KEY=...
OPENAI_API_KEY=sk-...

# --- Database ---
# Railway production must use PostgreSQL for the main SQLAlchemy database.
# Do not set AGENTYS_DB_PATH as a production fallback: the backend refuses to
# boot without DATABASE_URL to avoid split writes between Postgres and SQLite.
DATABASE_URL=${{Postgres.DATABASE_URL}}
AGENTYS_DATA_DIR=/data/agentys

# --- Frontend URL (pour les redirects OAuth post-auth) ---
# IMPORTANT: doit pointer vers le domaine frontend déployé
FRONTEND_URL=https://app.agentys.io

# --- Email Provider ---
# Gmail OAuth (recommandé)
EMAIL_PROVIDER_TYPE=GMAIL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# IMPORTANT: doit correspondre exactement à l'URI autorisée dans Google Cloud Console
# Ajouter https://<backend-domain>/api/oauth/gmail/callback dans les URIs autorisées
GOOGLE_REDIRECT_URI=https://<backend-domain>/api/oauth/gmail/callback

# --- Sentry (optionnel, déjà configuré dans le code) ---
# SENTRY_DSN=

# --- Logging ---
# Railway capture stdout/stderr — pas besoin de fichiers logs
LOG_TO_FILE=false

# --- Sync ---
SYNC_INTERVAL_SECONDS=30

# --- Batch API (optionnel) ---
BATCH_API_ENABLED=false
