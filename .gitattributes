# Source of truth for line endings. Always wins over core.autocrlf.
#
# Alex devs on Windows + Git Bash; CI runs on Linux (Hetzner + Railway);
# editors on Windows historically wrote CRLF on save. The combination
# produced thousands of phantom-line diffs on every PR and constant
# merge conflicts. All text gets stored as LF in the repo; binaries
# pass through.

# Catch-all: detect text vs binary; text files commit as LF.
* text=auto eol=lf

# Explicit text extensions — keeps detection deterministic if `auto`
# misclassifies anything (BOM-prefixed JSON, mixed-encoding fixtures, etc.).
*.py    text eol=lf
*.sh    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.env   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.lock  text eol=lf
*.svg   text eol=lf
Dockerfile      text eol=lf
Makefile        text eol=lf
.editorconfig   text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

# Explicit binaries — never line-end-normalize these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.mp3   binary
*.mp4   binary
*.wav   binary
*.db    binary
*.sqlite        binary
*.sqlite3       binary
