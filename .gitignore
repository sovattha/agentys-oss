.envrc
.envrc.local
agents/registry.json

# Secrets must never be committed (audit C-1, 2026-05-29). refund.json holds the
# Stripe secret for local/UI-configured installs; in prod the key is read from
# the STRIPE_SECRET_KEY env var. Ship refund.json.example instead.
# Placed after the `!app/data/**` re-include (line ~222) so last-match-wins re-ignores it.
app/data/agent_configs/refund.json

