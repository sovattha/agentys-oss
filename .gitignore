# Environment
config/.env
config/.env.backup
.env

# npm lockfile — le projet utilise yarn (voir agentys-app/yarn.lock).
# package-lock.json créé accidentellement si qqn lance `npm install`.
agentys-app/package-lock.json

# node_modules — agentys-app/node_modules est géré par agentys-app/.gitignore ;
# ce pattern attrape un node_modules racine créé par un `npm install` lancé
# par erreur à la racine du repo.
node_modules/

# Python
__pycache__/
*.py[cod]
*.so
.Python
venv/
.venv/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Data (optionnel - décommenter si vous ne voulez pas versionner les données)
# data/input/
# data/output/
token.json

# Données utilisateur
data/inputs/*.xlsx
data/outputs/*.xlsx
knowledge/memoire.md
knowledge/memoire.md.backup

# Données générées au runtime
data/*.db
data/*.json
data/**/*.json
data/.encryption_key
data/followups/
data/history/
data/learning/
data/mobile/
data/realtime_edit/

# Logs
logs/
*.log

# Backend runtime state — `.runtime/` carries live daemon logs
# (`backend.out.log*`) and ephemeral state written every session. Diffs
# on every `git status`; never source.
.runtime/

# Build / test ad-hoc output artefacts (regenerated by `tsc -b` and pytest
# redirections during local audits — never source).
agentys-app/tsc.err
agentys-app/tsc.out
pytest_full.err
pytest_full.out
pytest_x.err
pytest_x.out
# TypeScript incremental build cache. One per `tsconfig.json` with
# `composite: true` or `incremental: true` — root tsconfig, admin, mobile,
# etc. Use the glob so we don't have to maintain a per-app list.
*.tsbuildinfo

# Temporary debug/test files
tmp_*.json
test_*.json
nul

# Ad-hoc scripts (root level only)
/screenshot_*.py
/screenshot_*.png
/prototype-*.html
/audit_*.py
/_gen_audit.py
/test_*.py
/bug_*.py
/debug_*.py
/full_ui_check.py
/cleanup_*.py
/regenerate_*.py
/render_*.py
/trigger_*.py

# Audit screenshots
audit_screenshots/
test_screenshots/
agentys-app/audit_screenshots/

# Coverage
.coverage
htmlcov/
cov.json

# Artefacts d'orchestration
@ultra.*
@review-queue.md
@agent-task.md

# Nightly artifacts (local, auto-generated)
tasks/nightly-reports/launchd-*.log
tasks/nightly-reports/*_run.log
tasks/load-reports/

# Rapports nocturnes — on TRACKE les .md pour conserver la connaissance
# accumulée (findings audit, code-intel, memory-ingest) sur plusieurs
# machines et dans le temps. Seuls les logs bruts restent ignored (les
# .log launchd et *_run.log sont déjà couverts plus haut).
# NOTE : CLAUDE.md disait autrefois « gitignored rotation 14j » mais on a
# décidé de conserver en git — la rotation 14j côté disque peut rester
# (script cleanup), git garde l'historique complet.

# Vercel monitor artifacts (local, auto-generated) — on garde juste le README
tasks/vercel-reports/*.md
!tasks/vercel-reports/README.md
tasks/vercel-reports/.iterations-*
tasks/vercel-reports/.lock/

# Rapports audit e2e multi-agents (écrits par /audit-e2e, voir scripts/audit-prompts/)
tasks/audit-reports/

# Artefacts du refactor code-mort 2026-06-11 (graphes d'imports, baselines, logs A/B)
tasks/refactor-2026-06-11/

# Stress-test pipeline report — generated by `tools/stress_test_pipeline.py`
# (see memory ref `reference_stress_test_pipeline.md`). Regenerated on every
# scrubber/enforcement change; results live in the test run output, not git.
tasks/stress-pipeline-report.json

# Rapports de triage
tasks/triage-reports/

# Étude d'ablation critic KB (issue #251 phase 4c) — résultats LLM-as-judge
tasks/critic-kb-ablation/

# Label correction eval corpus (production-collected; contains user PII)
# Replayed by scripts/eval_label_corrections.py to regression-check prompt edits.
tasks/label_corrections.jsonl
tasks/eval-baseline.json
tasks/eval-current.json

.playwright-mcp/
inbox-overview.png
reports/

# Artefacts de test
test-results/
test_e2e_audit_results.json
web-bundles/

# Screenshots de test au niveau racine (audit, nightly, round2, captures ad-hoc
# de Playwright MCP). Les screenshots baseline e2e tracké restent dans
# agentys-app/e2e/screenshots/ (non matché par ce pattern root-only).
/*.png
/*.jpeg
/*.jpg
/*.webp
/*.gif
/*.txt
!/requirements.txt
!README*.txt
# Exceptions pour tout fichier .md/.yml à la racine
/snapshot-*.yml
/nightly-console-errors.txt
/nightly-network.txt

auth-test-*.png
magic-link-test.png
prototype_*.html

# Entités de debug
/entities.json

# Env backups
.env.bak.*

# Keys & certificates (CASA V1.11/V6.4 — never commit private material)
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
credentials.json
credentials-*.json
*-credentials.json
service-account*.json
.encryption-key.local
# Identifiants OAuth Google Sheets collectés en local (jamais committer).
# `token.json` plus haut ne couvre PAS `.sheets_token.json`.
tasks/.sheets_token.json
tasks/.sheets_auth_url.txt

# Playwright MCP locks + snapshots ad-hoc (pattern snap-*.yml en plus de snapshot-*.yml)
**/.claude/scheduled_tasks.lock
/snap-*.yml
/snap-*.txt

# Dossiers temp (tmp/, agentys-app/C:/ qui apparaît sur certains checkouts Windows)
/tmp/
agentys-app/C:/

# Screenshots de visual-audit.spec.ts — artefacts de documentation visuelle
# régénérés à chaque run (PAS des baselines de regression test, qui eux
# utiliseraient `expect(page).toHaveScreenshot()` dans un dossier dédié
# géré par Playwright). 13 MB de binary qui driftait à chaque commit.
agentys-app/e2e/screenshots/

