mempalace.yaml

# Claude Code tooling (ECC, AgentVibes, local config)
.claude/agents/
# Glob (not dir) so we can re-include specific commands/skills via `!` below.
.claude/commands/*
# Re-include shared slash command wrappers. The maintained bodies live in
# `.agents/skills/source-command-*`.
!.claude/commands/**/
!.claude/commands/*.md
!.claude/commands/**/*.md
!.claude/commands/agent-vibes/commands.json
.claude/skills/*
!.claude/skills/*
!.claude/skills/.gitkeep
!.claude/skills/.keep
.claude/skills/.DS_Store
!.claude/audit-live/
!.claude/audit-live/**
.claude/worktrees/
.claude/rules/
.claude/config/
.claude/settings*.json
.claude/tts-*.txt
.claude/github-star-reminder.txt
.dev-feature-state.json
.dev-feature-state.json.backup-*

# Claude Code runtime state inside sub-projects (mobile, mcp, etc.)
**/.claude/scheduled_tasks.lock

# Projects department — per-issue working artefacts (scoper/planner/review/tester).
# Active work only; cleared once the PR is merged.
.projects/

# API keys collected via automation (never commit)
.env.keys.local

# Daily standup transcripts (runtime output, regenerated daily on Hetzner)
ai_team/standups/*.md

# Yarn berry (yarn 4) — cf. https://yarnpkg.com/getting-started/qa#which-files-should-be-gitignored
.yarn/*
