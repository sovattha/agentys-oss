# API Backend URL
# En développement local: http://localhost:5050
# Via Cloudflare Tunnel: https://your-tunnel-name.trycloudflare.com
VITE_API_URL=http://localhost:5050

# Sentry frontend DSN (optionnel — L-1, audit issue #544)
# Public-by-design (bundlé dans le client) mais injecté via env pour
# permettre la rotation sans rebuild. Laisser vide pour désactiver
# le reporting (dev par défaut).
VITE_SENTRY_DSN=
