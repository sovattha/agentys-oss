# Configuration de l'app mobile Agentys
# Copier ce fichier en .env et adapter les valeurs

# URL du backend Agentys (sans slash final).
# Le WebSocket réutilise cette URL (namespace /daemon) — pas de variable dédiée.
# Prod : https://api.agentys.io
EXPO_PUBLIC_API_URL=http://localhost:5050

# Sentry crash reporting (optionnel — vide = désactivé).
# Public-by-design (bundlé client), rotation sans rebuild via env.
EXPO_PUBLIC_SENTRY_DSN=
