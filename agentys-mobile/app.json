{
  "expo": {
    "name": "Agentys",
    "slug": "agentys-mobile",
    "version": "1.0.0",
    "scheme": "agentys",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06080A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agentys.mobile",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Agentys utilise la reconnaissance vocale pour vous permettre de dicter vos réponses en mode conduite.",
        "NSMicrophoneUsageDescription": "Agentys utilise le microphone pour écouter vos commandes vocales en mode conduite.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.agentys.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-speech-recognition",
      "expo-web-browser",
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "owner": "alexandresimon",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000"
    }
  }
}
