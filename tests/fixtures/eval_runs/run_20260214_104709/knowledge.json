  "terminology": {
    "WAF": "Web Application Firewall - Security layer for production protection",
    "SLA": "Service Level Agreement - Guaranteed service availability percentage",
    "PKCE": "Proof Key for Code Exchange - OAuth2 security extension",
    "PSD2": "Payment Services Directive 2 - European payment regulation requiring compliance",
    "GraphQL": "Query language for APIs, replacing REST endpoints in Project Alpha",
    "mTLS": "Mutual TLS - Bidirectional certificate-based authentication",
    "JSON-LD": "JSON for Linked Data - Structured data exchange format",
    "DACH": "Germany (Deutschland), Austria, Switzerland region",
    "GDPR": "General Data Protection Regulation - EU data privacy law",
    "DPA": "Data Processing Agreement - Required for GDPR compliance",
    "POC": "Proof of Concept - Experimental implementation",
    "PR": "Pull Request - Code review submission on GitHub",
    "CSV": "Comma-Separated Values - Data export format",
    "API": "Application Programming Interface",
    "REST": "Representational State Transfer - API architecture style",
    "OAuth2": "Open Authorization 2.0 - Authentication protocol",
    "Rate limiting": "Request throttling by client tier",
    "Backward compat": "Backward compatibility - Supporting older versions",
    "Burst": "Temporary spike in request rate allowed above normal limit",
    "Sprint": "2-week development cycle in Agile methodology",
    "Q1": "First quarter of the year (January-March)",
    "JIRA": "Project management and issue tracking tool"
  },
