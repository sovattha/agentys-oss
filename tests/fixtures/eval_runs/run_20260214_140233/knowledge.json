  "terminology": {
    "WAF": "Web Application Firewall - pare-feu applicatif web pour protection production",
    "SLA": "Service Level Agreement - accord de niveau de service avec garantie de disponibilité",
    "PKCE": "Proof Key for Code Exchange - extension OAuth2 pour sécuriser l'authentification",
    "mTLS": "Mutual TLS - authentification TLS bidirectionnelle pour sécuriser les échanges API",
    "JSON-LD": "JSON for Linking Data - format de données structurées pour échange inter-systèmes",
    "PSD2": "Payment Services Directive 2 - directive européenne sur les services de paiement",
    "CSP": "Content Security Policy - politique de sécurité du contenu HTTP",
    "DACH": "Deutschland Austria Confoederatio Helvetica - zone économique Allemagne Autriche Suisse",
    "DPA": "Data Processing Agreement - accord de traitement des données GDPR",
    "GraphQL": "Langage de requête pour API, alternative à REST",
    "OAuth2": "Protocole d'autorisation pour sécuriser les API",
    "Rate limiting": "Limitation du nombre de requêtes API par client",
    "Chunked transfer encoding": "Encodage HTTP pour envoi de données en flux continu",
    "POC": "Proof of Concept - preuve de concept",
    "Sprint": "Itération de développement agile (généralement 2 semaines)"
  },
