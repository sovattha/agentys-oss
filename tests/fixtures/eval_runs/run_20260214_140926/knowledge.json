  "terminology": {
    "WAF": "Web Application Firewall - Pare-feu applicatif web",
    "SLA": "Service Level Agreement - Accord de niveau de service",
    "PKCE": "Proof Key for Code Exchange - Extension de sécurité OAuth2",
    "mTLS": "Mutual TLS - Authentification TLS mutuelle",
    "JSON-LD": "JSON for Linking Data - Format d'échange de données structurées",
    "GraphQL": "Langage de requête pour API, alternative à REST",
    "OAuth2": "Protocole d'autorisation standard pour l'authentification",
    "GDPR": "General Data Protection Regulation - Règlement Général sur la Protection des Données",
    "DPA": "Data Processing Agreement - Accord de traitement des données",
    "PSD2": "Payment Services Directive 2 - Directive européenne sur les services de paiement",
    "DACH": "Deutschland, Austria, Confoederatio Helvetica - Région Allemagne-Autriche-Suisse",
    "CSP": "Content Security Policy - Politique de sécurité du contenu",
    "Rate limiting": "Limitation du nombre de requêtes API par unité de temps",
    "Backward compatibility": "Compatibilité ascendante - maintien de la compatibilité avec versions antérieures",
    "Streaming": "Transmission de données en flux continu sans chargement complet en mémoire",
    "Sprint": "Itération de développement en méthode agile (généralement 2 semaines)"
  },
