  "terminology": {
    "WAF": "Web Application Firewall - Pare-feu applicatif pour protéger les applications web",
    "SLA": "Service Level Agreement - Accord de niveau de service définissant la disponibilité et les délais de réponse",
    "PKCE": "Proof Key for Code Exchange - Extension de sécurité pour OAuth2",
    "OAuth2": "Protocole d'autorisation standard pour l'authentification API",
    "GraphQL": "Langage de requête API alternatif à REST permettant des requêtes flexibles",
    "mTLS": "Mutual TLS - Authentification bidirectionnelle par certificats",
    "JSON-LD": "JSON for Linked Data - Format d'échange de données structurées",
    "PSD2": "Payment Services Directive 2 - Directive européenne sur les services de paiement",
    "GDPR": "General Data Protection Regulation - Règlement général sur la protection des données",
    "DPA": "Data Processing Agreement - Accord de traitement des données",
    "CSP": "Content Security Policy - Politique de sécurité du contenu web",
    "Rate limiting": "Limitation du nombre de requêtes API par client pour éviter la surcharge",
    "Backward compatibility": "Compatibilité ascendante - maintien du support des anciennes versions",
    "POC": "Proof of Concept - Prototype de validation de concept",
    "Sprint": "Itération de développement agile de 2 semaines",
    "DACH": "Deutschland, Austria, Confoederatio Helvetica - Région germanophone (Allemagne, Autriche, Suisse)"
  },
