  "terminology": {
    "WAF": "Web Application Firewall - couche de protection pour la production",
    "SLA": "Service Level Agreement - accord de niveau de service",
    "PKCE": "Proof Key for Code Exchange - extension OAuth2 pour sécurité renforcée",
    "mTLS": "Mutual TLS - authentification TLS bidirectionnelle",
    "JSON-LD": "JSON for Linked Data - format d'échange de données structurées",
    "CSP": "Content Security Policy - politique de sécurité du contenu",
    "PSD2": "Payment Services Directive 2 - directive européenne services de paiement",
    "DACH": "Deutschland, Austria, Confederatio Helvetica - région Allemagne/Autriche/Suisse",
    "DPA": "Data Processing Agreement - accord de traitement des données",
    "POC": "Proof of Concept - preuve de concept",
    "Rate limiting": "Limitation du nombre de requêtes API par période",
    "Backward compat": "Backward compatibility - compatibilité ascendante"
