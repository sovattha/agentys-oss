  "terminology": {
    "WAF": "Web Application Firewall - pare-feu applicatif pour la protection web",
    "SLA": "Service Level Agreement - accord de niveau de service",
    "PKCE": "Proof Key for Code Exchange - extension de securite OAuth2",
    "GraphQL": "Langage de requete pour API, alternative a REST",
    "mTLS": "Mutual TLS - authentification TLS bidirectionnelle",
    "JSON-LD": "JSON for Linking Data - format d'echange de donnees structurees",
    "PSD2": "Payment Services Directive 2 - directive europeenne sur les services de paiement",
    "DACH": "Germany (Deutschland), Austria, Switzerland - region marche Europe centrale",
    "DPA": "Data Processing Agreement - accord de traitement des donnees",
    "GDPR": "General Data Protection Regulation - reglement general sur la protection des donnees",
    "POC": "Proof of Concept - preuve de concept",
    "PR": "Pull Request - demande de fusion de code",
    "REST": "Representational State Transfer - architecture API",
    "OAuth2": "Open Authorization 2.0 - protocole d'autorisation",
    "CSP": "Content Security Policy - politique de securite du contenu",
    "Rate limiting": "Limitation du nombre de requetes API par periode"
  },
