  "terminology": {
    "WAF": "Web Application Firewall - Pare-feu applicatif pour protéger les applications web",
    "SLA": "Service Level Agreement - Accord sur les niveaux de service (disponibilité, temps de réponse)",
    "PKCE": "Proof Key for Code Exchange - Extension de sécurité pour OAuth2",
    "mTLS": "Mutual TLS - Authentification TLS bidirectionnelle avec certificats clients et serveurs",
    "JSON-LD": "JSON for Linking Data - Format d'échange de données structurées avec contexte sémantique",
    "CSP": "Content Security Policy - Politique de sécurité du contenu pour prévenir les attaques XSS",
    "PSD2": "Payment Services Directive 2 - Directive européenne sur les services de paiement",
    "DPA": "Data Processing Agreement - Accord de traitement des données (GDPR)",
    "GDPR": "General Data Protection Regulation - Règlement général sur la protection des données",
    "DACH": "Deutschland, Austria, Confoederatio Helvetica - Région germanophone (Allemagne, Autriche, Suisse)",
    "GraphQL": "Langage de requête pour API, alternative à REST avec schéma typé",
    "OAuth2": "Protocole d'autorisation pour déléguer l'accès sécurisé",
    "REST": "Representational State Transfer - Architecture d'API basée sur HTTP",
    "CI/CD": "Continuous Integration / Continuous Deployment - Intégration et déploiement continus",
    "POC": "Proof of Concept - Preuve de concept"
  },
