  "terminology": {
    "GAP": "Garantie Actif/Passif — clause contractuelle dans les opérations de fusion-acquisition garantissant l'acheteur contre les passifs non révélés",
    "Due diligence": "Audit juridique approfondi réalisé avant une opération d'acquisition",
    "Data room": "Espace virtuel sécurisé contenant l'ensemble de la documentation juridique d'une société cible",
    "Closing": "Réunion finale de signature des actes de cession et de transfert de propriété",
    "Conditions suspensives": "Conditions devant être réalisées avant la finalisation d'une opération (ex: autorisation AMF)",
    "Séquestre": "Somme bloquée provisoirement pour garantir l'exécution d'obligations contractuelles",
    "Référé provision": "Procédure d'urgence permettant d'obtenir rapidement le paiement d'une somme non sérieusement contestable",
    "AMF": "Autorité des Marchés Financiers",
    "RGPD": "Règlement Général sur la Protection des Données",
    "Kbis": "Document officiel attestant de l'existence juridique d'une entreprise",
    "Golden parachute": "Clause d'indemnité de départ pour les dirigeants",
    "MAC": "Material Adverse Change — changement défavorable significatif"
  },
