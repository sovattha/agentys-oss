  "terminology": {
    "M&A": "Mergers and Acquisitions - Fusions-acquisitions",
    "Due diligence": "Audit juridique approfondi d'une société cible avant acquisition",
    "GAP": "Garantie Actif/Passif - mécanisme de garantie dans les opérations de cession",
    "Closing": "Réunion finale de signature des actes de cession et transfert de propriété",
    "Data room": "Espace virtuel sécurisé contenant la documentation juridique d'une société",
    "Kbis": "Extrait du registre du commerce et des sociétés attestant l'existence juridique d'une entreprise",
    "RCS": "Registre du Commerce et des Sociétés",
    "RGPD": "Règlement Général sur la Protection des Données",
    "Golden parachutes": "Indemnités de départ contractuelles des dirigeants",
    "Engagements hors bilan": "Engagements financiers n'apparaissant pas au bilan comptable",
    "Référé provision": "Procédure d'urgence pour obtenir une provision sur une créance non sérieusement contestable",
    "Numéro RG": "Numéro de Rôle Général attribué par le greffe lors de l'enrôlement d'une affaire",
    "Assignation": "Acte d'huissier convoquant une partie devant le tribunal",
    "Protocole d'accord": "Contrat définissant les conditions d'une opération de fusion-acquisition",
    "Conditions suspensives": "Événements futurs et incertains dont dépend la réalisation d'une opération",
    "Séquestre": "Somme bloquée auprès d'un tiers pour garantir l'exécution d'obligations",
    "Seuil de déclenchement": "Montant minimum à partir duquel la garantie actif/passif peut être activée",
    "Franchise": "Montant en deçà duquel l'acquéreur supporte seul les sinistres",
    "Plafond": "Montant maximum de garantie dans une clause de garantie actif/passif",
    "Cass. com.": "Chambre commerciale de la Cour de cassation",
    "DPO": "Data Protection Officer - Délégué à la Protection des Données",
    "AMF": "Autorité des Marchés Financiers",
    "Changement défavorable significatif": "MAC clause - Material Adverse Change",
    "Convention de correspondance": "Accord de partenariat entre cabinets d'avocats de différents pays"
