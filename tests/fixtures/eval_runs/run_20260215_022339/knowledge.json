  "terminology": {
    "ARR": "Annual Recurring Revenue - revenu récurrent annuel",
    "MRR": "Monthly Recurring Revenue - revenu récurrent mensuel",
    "churn": "Taux d'attrition clients (pourcentage de clients perdus)",
    "cap table": "Table de capitalisation (répartition des parts de l'entreprise)",
    "data room": "Espace sécurisé de partage de documents pour due diligence",
    "term sheet": "Lettre d'intention d'investissement avec conditions financières",
    "board deck": "Présentation pour le conseil d'administration/investisseurs",
    "due diligence": "Audit approfondi avant investissement",
    "Series A": "Premier tour de financement institutionnel significatif",
    "cohort": "Groupe d'utilisateurs ayant commencé à utiliser le produit à la même période",
    "NPS": "Net Promoter Score - indicateur de satisfaction client",
    "SSO": "Single Sign-On - authentification unique",
    "SAML": "Security Assertion Markup Language - protocole d'authentification",
    "SCIM": "System for Cross-domain Identity Management - provisioning automatique d'utilisateurs",
    "POC": "Proof of Concept - preuve de concept/pilote",
    "DSI": "Directeur des Systèmes d'Information - CTO/CIO",
    "RGPD": "Règlement Général sur la Protection des Données",
    "SLA": "Service Level Agreement - accord de niveau de service",
    "SOC 2": "Certification de sécurité des systèmes d'information",
    "pentest": "Test de pénétration - audit de sécurité offensif",
    "WAF": "Web Application Firewall - pare-feu applicatif",
    "IAM": "Identity and Access Management - gestion des identités et accès",
    "K-bis": "Extrait du registre du commerce français (équivalent incorporation certificate)",
    "RC Pro": "Responsabilité Civile Professionnelle - assurance professionnelle",
    "BPI France": "Banque Publique d'Investissement - organisme public de financement",
    "bull/bear scenario": "Scénarios financiers optimiste/pessimiste",
    "net retention": "Taux de rétention net incluant upsells et churn",
    "time to value": "Temps avant que l'utilisateur obtienne de la valeur du produit",
    "activation rate": "Pourcentage d'utilisateurs qui complètent l'onboarding"
  },
