  "terminology": {
    "engagement": "Client consulting mission or project",
    "Phase 1 / Phase 2": "Sequential project stages (diagnostic then implementation)",
    "workstream": "Distinct work track or project component within an engagement",
    "quick wins": "High-impact, low-effort initiatives delivering rapid results",
    "diagnostic": "Initial assessment phase to identify issues and opportunities",
    "strawman": "Draft proposal or framework for discussion and refinement",
    "target-state / current-state": "Future desired state vs. present situation in transformation projects",
    "steering committee": "Client governance body overseeing project direction",
    "governance": "Decision-making framework and oversight structure",
    "change management": "Approach to managing organizational and people impacts of transformation",
    "operating model": "How an organization structures, processes, and resources work",
    "BU head interviews": "Interviews with Business Unit leaders",
    "FTE numbers": "Full-Time Equivalent employee counts",
    "indirect cost allocation": "Method of assigning overhead costs to business units",
    "context pack": "Briefing document providing project background",
    "workstream charter": "Document defining scope, objectives, and deliverables for a workstream",
    "deliverables": "Outputs or work products from a project",
    "dependencies": "Elements that must be completed before subsequent work can proceed",
    "McKinsey 7S framework": "Strategy consulting tool analyzing seven organizational elements (Strategy, Structure, Systems, Shared Values, Skills, Style, Staff)",
    "revenue: on budget": "Project revenue tracking vs. planned amount",
    "portfolio": "Collection of active client engagements",
    "anchor too low": "Setting fees below appropriate market rate for scope",
    "benchmark": "Comparative analysis against similar projects or industry standards",
    "RACI matrix": "Responsibility assignment chart (Responsible, Accountable, Consulted, Informed)",
    "spans and layers": "Analysis of organizational hierarchy and management control spans",
    "value streams": "End-to-end processes that create value for customers",
    "CX transformation": "Customer Experience transformation initiative",
    "proof of concept": "Small-scale trial project to demonstrate viability before full commitment"
  },
