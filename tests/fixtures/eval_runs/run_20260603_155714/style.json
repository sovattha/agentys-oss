  "general_rules": [
    {
      "description": "Tutoyer l'équipe interne (collègues du même domaine) avec salutation prénom seul et closing minimaliste (prénom ou rien)"
    },
    {
      "description": "Vouvoyer les clients externes et utiliser formule de politesse complète (Bien cordialement, / Cordialement,) avec signature professionnelle complète"
    },
    {
      "description": "Adapter le registre au contexte relationnel : transition de formal à semi-formal avec partenaires professionnels après première prise de contact"
    },
    {
      "description": "Utiliser des listes à puces numérotées ou tirets pour structurer les informations (dossiers, points d'action, atouts du bien)"
    },
    {
      "description": "Intégrer des données chiffrées précises (prix, surface, pourcentage, montants) dans chaque communication commerciale ou de suivi"
    },
    {
      "description": "Employer un jargon immobilier spécialisé sans définition : mandat exclusif, avis de valeur, DPE, compromis, séquestre, rendement locatif brut, offre d'achat, diagnostics techniques, plan de communication premium"
    },
    {
      "description": "Ajouter des emojis occasionnels en contexte interne ou semi-formel (🎉, 👍, 😉) mais jamais avec clients formels"
    },
    {
      "description": "Proposer des alternatives de dates/horaires (jeudi 16 ou vendredi 17) pour faciliter la prise de rendez-vous"
    },
    {
      "description": "Inclure des informations contextuelles pertinentes (références cadastrales, charges, année de construction) pour préparer les estimations"
    },
    {
      "description": "Utiliser des formules de relance directes et courtes en interne (T'en es où, Faut qu'on parle, Tu peux) sans détour"
    }
  ],
  "forbidden_phrases": []
}